NODE_ENV=development            # development | production | test
PORT=4000

# --- Selector de base de datos ---
DB_TARGET=local                 # local -> Studio3T / mongod local ; atlas -> MongoDB Atlas
MONGO_URI_LOCAL=mongodb://localhost:27017/?retryWrites=true&loadBalanced=false&serverSelectionTimeoutMS=5000&connectTimeoutMS=10000
MONGO_URI_ATLAS=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=til_platform

# --- JWT (mínimo 32 caracteres, distintos entre sí) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS: lista blanca separada por comas (sin "*") ---
CORS_ORIGINS=http://localhost:5173

# --- Admin inicial (solo lo usa scripts/seed-admin.js) ---
ADMIN_USERNAME=MAYLOB_CONTROL
ADMIN_PASSWORD=

# Secreto de los tokens de la otra web app (distinto a los de admin)
JWT_CLIENT_SECRET=genera-uno-distinto-con-crypto-randomBytes-64
JWT_CLIENT_TTL=1h
